# Copy to .env.local for local development. Never commit .env.local.
# SETUP.md explains where every value comes from and how to set it in Vercel.

# ---------------------------------------------------------------------------
# Supabase (database + image storage)
# Project URL and keys: Supabase Dashboard → Project Settings → API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (new projects: "sb_publishable_..."; older projects: the "anon" JWT).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret key — SERVER ONLY. Used by the seed/translate scripts and /api/translate.
# (New projects: "sb_secret_..."; older projects: the "service_role" JWT.)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Translations. Provider is picked automatically: Anthropic if its key is set,
# else Gemini, else off. Or force it: TRANSLATION_PROVIDER=anthropic | gemini | off
# ---------------------------------------------------------------------------
# TRANSLATION_PROVIDER=anthropic

# Anthropic (recommended) — https://platform.claude.com → API keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model. Every AI job defaults to claude-haiku-5-5
# (cheapest); claude-sonnet-5-5 or claude-opus-5-5 cost many times more.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Google Gemini (free tier) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy...
# Optional: override the model (default gemini-3.5-flash).
# GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Shared secret that protects /api/translate and /api/revalidate.
# Generate one with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
TRANSLATE_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed site. Only the scripts and the Maintenance workflow
# use it (to refresh the cache after translating); the site itself does not read
# it, so it is not needed in Vercel.
SITE_URL=https://kingdom-1241.vercel.app

# Encrypts `npm run backup` files (and the weekly backup artifact). 16+ characters;
# generate one with `openssl rand -hex 32` and keep it somewhere safe outside the
# repository: without it a backup cannot be read. SETUP.md § 10.
# BACKUP_PASSPHRASE=

# ---------------------------------------------------------------------------
# KvK battle plan (password-locked page)
# ---------------------------------------------------------------------------
# Signs the access cookie. Optional: falls back to TRANSLATE_WEBHOOK_SECRET.
# KVK_SESSION_SECRET=another-long-random-string
# Password written into the placeholder plan by `npm run db:seed` (default 1241).
# Change the real password any time in the kvk_plans table — every visitor is
# logged out automatically.
# KVK_SEED_PASSWORD=1241
# The rally-leader and commander pages have their own (SETUP.md § 9).
# KVK_SEED_LEADER_PASSWORD=1241-leaders
# KVK_SEED_CHECKLIST_PASSWORD=1241-commander
# Battle feedback: checks a player's Governor ID against MightPulse and fills in
# their in-game name and alliance. Create a key at https://api.mightpulse.com
# (sign in with Discord → API key). Optional: without it, or while MightPulse
# is down, players type name and alliance themselves. SETUP.md § 9.
# MIGHTPULSE_API_KEY=kss_...
# AI step of the battle feedback (Admin → Feedback → Results → "Translate and
# analyse"): uses the translation provider above. Optional model overrides for
# Anthropic: the bulk translation of player texts and the summary, both
# claude-haiku-5-5 by default. Gemini uses GEMINI_MODEL for both.
# RETRO_TRANSLATE_MODEL=claude-haiku-5-5
# RETRO_ANALYSIS_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Logging (optional). Production logs are JSON lines (searchable in Vercel);
# development logs are coloured. LOG_LEVEL: debug | info | warn | error.
# ---------------------------------------------------------------------------
# LOG_LEVEL=info
# LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Discord OAuth for the admin sign-in. These only configure the Supabase Auth
# provider (SETUP.md § 8.1); the site itself never reads them.
# Discord Developer Portal → OAuth2.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Admin area. Admins and moderators sign in with Discord (SETUP.md § 8).
# ---------------------------------------------------------------------------
# The site owner: your Discord username (the handle, not the display name). The
# owner is always an administrator, can't be demoted, and is the only one who can
# appoint or remove administrators; administrators appoint moderators. Set the
# same value in Vercel. Best: your Discord user id (Discord → User Settings →
# Advanced → Developer Mode, then "Copy User ID" on your profile): it never
# changes, while a handle can be renamed and re-registered. A handle works too.
# For local development it may be the dev account's e-mail, or a comma-separated
# list such as "<discord id or handle>,<dev e-mail>" so both count.
SITE_OWNER=
# Optional: a Discord incoming webhook (Server settings → Integrations → Webhooks)
# that receives council alerts, e.g. a brute-force attempt on the battle-plan
# password. Without it, alerts only reach the admin change log and the server log.
# ALERT_DISCORD_WEBHOOK_URL=

# Local development only: shows an e-mail + password form on the admin login
# page so the admin area works before the Discord application exists. Ignored
# by production builds; never set it in Vercel. Create the account with
# `npm run dev:admin` (uses DEV_ADMIN_EMAIL and DEV_ADMIN_PASSWORD) and set
# SITE_OWNER to that e-mail so the account is the owner.
# ADMIN_DEV_LOGIN=1
# DEV_ADMIN_EMAIL=dev-admin@kingdom1241.local
# DEV_ADMIN_PASSWORD=

# Local review only: Rally Sync without the database. Rooms live in the server
# process (gone on restart) and a demo room TEST23 (password review123) is always
# there; pages poll instead of using Realtime. Ignored on Vercel; never set it there.
# RALLY_SYNC_STORE=memory
