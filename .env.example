# Copy to .env.local for local development. Never commit .env.local.
# SETUP.md explains where every value comes from and how to set it in Vercel.

# ---------------------------------------------------------------------------
# Supabase (database + image storage)
# Project URL and keys: Supabase Dashboard → Project Settings → API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (new projects: "sb_publishable_..."; older projects: the "anon" JWT).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret key — SERVER ONLY. Used by the seed/translate scripts and /api/translate.
# (New projects: "sb_secret_..."; older projects: the "service_role" JWT.)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Gemini (translations) — Google AI Studio → Get API key
# ---------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
# Optional: override the model (default gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Shared secret that protects /api/translate and /api/revalidate.
# Generate one with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
TRANSLATE_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed site (used by `npm run translate` to refresh the cache).
SITE_URL=https://kingdom-1241.vercel.app

# ---------------------------------------------------------------------------
# Discord OAuth (phase 2: admin login). Not used by the site yet, but set up now
# so the Supabase Auth provider is ready. Discord Developer Portal → OAuth2.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
